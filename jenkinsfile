pipeline {
    agent any

    tools {
        maven 'MV'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Code successfully received from Git'
            }
        }

        stage('Build & Test') {
            steps {
                echo 'Running Maven: Building...'
                bat 'mvn clean install -DskipTests=true'
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                echo 'JAR file saved as a build artifact'
            }
        }

        stage('Deploy to DEV') {
            steps {
                echo 'Deployment on test server...'
            }
        }
    }

    post {
        always {
            echo 'Pipeline is complete.'
        }
        failure {
            mail to: 'devops@example.com',
                    subject: 'BUILD FAILURE: weather-app',
                    body: "Build #${env.BUILD_NUMBER} of the weather-app project ended with an error. Check the logs: ${env.BUILD_URL}"

        }
    }
}